{
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/analytics/intensityV2.ts",
    "src/lib/analytics/intensityDistribution.ts",
    "src/lib/analytics/rulesEngine.ts",
    "src/lib/analytics/trainingLoad.ts",
    "src/lib/analytics/runningPatterns.ts",
    "src/lib/analytics/strength-generator.ts"
  ],
  "thresholds": {
    "high": 70,
    "low": 50,
    "break": 30
  },
  "reporters": ["clear-text", "progress"],
  "concurrency": 4,
  "timeoutMS": 30000
}
