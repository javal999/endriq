{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [],
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
